{
  "name": "QuestFeedback",
  "type": "object",
  "properties": {
    "quest_id": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "clarity": {
      "type": "string",
      "enum": [
        "clear",
        "okay",
        "confusing"
      ]
    },
    "difficulty_feel": {
      "type": "string",
      "enum": [
        "easier",
        "accurate",
        "harder"
      ]
    },
    "broken_link": {
      "type": "boolean",
      "default": false
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "quest_id",
    "rating"
  ],
  "rls": {
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}