{
  "name": "Submission",
  "type": "object",
  "properties": {
    "quest_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "clue",
        "final"
      ]
    },
    "clue_index": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "correct": {
      "type": "boolean",
      "default": false
    },
    "player_id": {
      "type": "string"
    }
  },
  "required": [
    "quest_id",
    "kind"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
