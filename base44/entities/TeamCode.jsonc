{
  "name": "TeamCode",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    }
  },
  "required": [
    "team_id",
    "code"
  ],
  "rls": {
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}