{
  "name": "Quest",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "briefing": {
      "type": "string"
    },
    "head_question": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "history",
        "internet",
        "general",
        "science",
        "technology",
        "culture",
        "geography",
        "other"
      ],
      "default": "general"
    },
    "difficulty": {
      "type": "number",
      "default": 2
    },
    "est_minutes": {
      "type": "number",
      "default": 25
    },
    "language": {
      "type": "string",
      "default": "English"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "under_review"
      ],
      "default": "draft"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "default": "public"
    },
    "clue_reveal": {
      "type": "string",
      "enum": [
        "all",
        "sequential"
      ],
      "default": "all"
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "start_url": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "submission_format": {
            "type": "string"
          },
          "hint1": {
            "type": "string"
          },
          "hint2": {
            "type": "string"
          }
        }
      }
    },
    "creator_username": {
      "type": "string"
    },
    "source_note": {
      "type": "string"
    },
    "validation_status": {
      "type": "string"
    },
    "doctor_score": {
      "type": "number"
    },
    "doctor_passed": {
      "type": "boolean"
    },
    "report_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.status": "published"
            },
            {
              "data.visibility": {
                "$in": [
                  "public",
                  "unlisted"
                ]
              }
            }
          ]
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}