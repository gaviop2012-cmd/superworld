{
  "name": "TeamComment",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string"
    },
    "quest_id": {
      "type": "string"
    },
    "clue_index": {
      "type": "number"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "team_id",
    "text"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}