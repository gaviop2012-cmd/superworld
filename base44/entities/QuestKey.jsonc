{
  "name": "QuestKey",
  "type": "object",
  "properties": {
    "quest_id": {
      "type": "string"
    },
    "final_answer": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "string"
    },
    "rights_ack": {
      "type": "boolean",
      "default": false
    },
    "clue_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contribution": {
            "type": "string"
          },
          "evidence_excerpt": {
            "type": "string"
          },
          "checked_on": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "quest_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}